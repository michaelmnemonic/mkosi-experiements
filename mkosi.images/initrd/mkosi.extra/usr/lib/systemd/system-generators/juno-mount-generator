#!/bin/sh
# SPDX-License-Identifier: MIT
# systemd generator run in the initrd to discover and mount a versioned
# EROFS /usr image from the @usr btrfs subvolume on the root partition.
#
# Layout on the root btrfs partition:
#   @ (default subvolume)  →  mounted at /sysroot by systemd gpt-auto
#   @usr (nodatacow)        →  contains usr-${IMAGE_VERSION}.erofs
#
# This generator creates two mount units:
#   1. sysroot-.usr.mount     — mounts @usr subvolume at /sysroot/.usr
#   2. sysroot-usr.mount      — mounts the EROFS from there at /sysroot/usr

set -eu

normal_dir="$1"
early_dir="$2"
late_dir="$3"

# Only run in the initrd
if [ "${SYSTEMD_IN_INITRD:-0}" != "1" ]; then
    exit 0
fi

echo "juno-mount-generator: starting"

# Source os-release to get IMAGE_VERSION
if [ -f /usr/lib/os-release ]; then
    # shellcheck source=/dev/null
    . /usr/lib/os-release
elif [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
fi

if [ -z "${IMAGE_VERSION:-}" ]; then
    echo "juno-mount-generator: IMAGE_VERSION not set in os-release, refusing to continue"
    exit 1
fi

EROFS_FILENAME="usr-${IMAGE_VERSION}.erofs"

echo "juno-mount-generator: using EROFS file $EROFS_FILENAME"

# --- Mount unit 1: Mount @usr btrfs subvolume at /sysroot/.usr ---
# The unit file name follows systemd path encoding: /sysroot/.usr → sysroot-.usr.mount
mkdir -p "$normal_dir"

cat > "$normal_dir/sysroot-.usr.mount" <<EOF
# Generated by juno-mount-generator

[Unit]
Description=Mount @usr subvolume for EROFS images
DefaultDependencies=no
After=sysroot.mount
After=blockdev@dev-gpt\x2dauto\x2droot.target
Before=initrd-usr-fs.target
Requires=sysroot.mount

[Mount]
What=/dev/gpt-auto-root
Where=/sysroot/.usr
Type=btrfs
Options=subvol=/@usr,ro,nodev,noexec
EOF

# --- Mount unit 2: Mount the EROFS image at /sysroot/usr ---

cat > "$normal_dir/sysroot-usr.mount" <<EOF
# Generated by juno-mount-generator

[Unit]
Description=Mount EROFS /usr image
DefaultDependencies=no
After=sysroot-.usr.mount
Before=initrd-usr-fs.target
Requires=sysroot-.usr.mount

[Mount]
What=/sysroot/.usr/${EROFS_FILENAME}
Where=/sysroot/usr
Type=erofs
Options=ro
EOF

# --- Wire both units into initrd-usr-fs.target ---

mkdir -p "$normal_dir/initrd-usr-fs.target.requires"
ln -s "../sysroot-.usr.mount" "$normal_dir/initrd-usr-fs.target.requires/sysroot-.usr.mount"
ln -s ../sysroot-usr.mount "$normal_dir/initrd-usr-fs.target.requires/sysroot-usr.mount"

echo "juno-mount-generator: done"
